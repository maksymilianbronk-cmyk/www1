# LeadFlow CRM — twardnienie serwera (Apache/LiteSpeed)
Options -Indexes

# Pliki wewnętrzne nie do pobrania przez HTTP
<FilesMatch "^(config|ui|filters)\.php$|\.(md|sqlite|gitignore)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
